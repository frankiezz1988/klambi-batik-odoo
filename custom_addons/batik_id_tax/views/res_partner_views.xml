<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_btk_tax" model="ir.ui.view">
        <field name="name">res.partner.form.btk.tax</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="btk_npwp"/>
                <field name="btk_nik"/>
                <field name="btk_is_pkp"/>
                <field name="btk_tku_id" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>
</odoo>
