<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_btk_coretax_export_form" model="ir.ui.view">
        <field name="name">btk.coretax.export.form</field>
        <field name="model">btk.coretax.export</field>
        <field name="arch" type="xml">
            <form string="Ekspor Faktur Keluaran Coretax (staging)">
                <div class="alert alert-warning" role="alert">
                    CSV mengikuti konsep kolom template Excel DJP: pindahkan ke template resmi (cek sheet REF) lalu
                    gunakan converter DJP. XML bersifat EKSPERIMENTAL dan belum divalidasi. NSFP diterbitkan Coretax
                    saat faktur ditandatangani; gunakan menu Impor NSFP setelahnya.
                </div>
                <group invisible="state != 'draft'">
                    <group>
                        <field name="state" invisible="1"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="only_pending"/>
                        <field name="mark_exported"/>
                        <field name="default_unit"/>
                    </group>
                </group>
                <group invisible="state != 'done'">
                    <field name="invoice_count"/>
                    <field name="faktur_file" filename="faktur_name"/>
                    <field name="faktur_name" invisible="1"/>
                    <field name="detail_file" filename="detail_name"/>
                    <field name="detail_name" invisible="1"/>
                    <field name="xml_file" filename="xml_name"/>
                    <field name="xml_name" invisible="1"/>
                    <field name="warnings" invisible="not warnings"/>
                </group>
                <footer>
                    <button string="Buat File" name="action_export" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Tutup" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_btk_nsfp_import_form" model="ir.ui.view">
        <field name="name">btk.nsfp.import.form</field>
        <field name="model">btk.nsfp.import</field>
        <field name="arch" type="xml">
            <form string="Impor NSFP dari Coretax">
                <group>
                    <field name="state" invisible="1"/>
                    <field name="file" filename="filename" invisible="state != 'draft'"/>
                    <field name="filename" invisible="1"/>
                    <field name="result" invisible="state != 'done'"/>
                </group>
                <p class="text-muted" invisible="state != 'draft'">
                    CSV dengan kolom <b>invoice_number</b> (atau <b>ref_order</b>) dan <b>nsfp</b>.
                </p>
                <footer>
                    <button string="Impor" name="action_import" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Tutup" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_btk_coretax_export" model="ir.actions.act_window">
        <field name="name">Ekspor Coretax (staging)</field>
        <field name="res_model">btk.coretax.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="action_btk_nsfp_import" model="ir.actions.act_window">
        <field name="name">Impor NSFP</field>
        <field name="res_model">btk.nsfp.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_btk_coretax_export" name="Ekspor Faktur Keluaran (Coretax)"
              parent="batik_id_tax.menu_btk_root" action="action_btk_coretax_export" sequence="10"/>
    <menuitem id="menu_btk_nsfp_import" name="Impor NSFP dari Coretax"
              parent="batik_id_tax.menu_btk_root" action="action_btk_nsfp_import" sequence="20"/>
</odoo>
