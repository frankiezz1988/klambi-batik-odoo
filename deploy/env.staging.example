# Demo = satu stack ini. Salin ke <repo>/env.staging di VPS (chmod 600). JANGAN commit.
STACK=staging
ODOO_VERSION=19.0
ODOO_DB=batik_staging
ODOO_PORT=18069
ODOO_GEVENT_PORT=18072
PG_USER=odoo_staging
PG_PASSWORD=GANTI_PASSWORD_ACAK_1
ADMIN_PASSWD=GANTI_MASTER_PASSWORD_1
# VPS kecil: workers=0 (threaded, websocket lewat 8069)
ODOO_WORKERS=0
ODOO_LOG_LEVEL=info
ODOO_MEM_LIMIT=1100m
DB_MEM_LIMIT=400m
PG_SHARED_BUFFERS=96MB
BACKUP_DIR=/opt/batik/backups/staging
# Staging boleh berisi data dummy
SEED_DEMO=1
DEMO_MONTHS=6
DEMO_ORDERS_PER_MONTH=60
DEMO_SEED=2026
PPH22_START=2026-11-01

# Cloudflare Tunnel (token dari dashboard: Zero Trust > Networks > Tunnels > Create > Docker)
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=
